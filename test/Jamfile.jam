import testing ;

project
  : requirements
   <define>BOOST_AUTO_TEST_MAIN
   <define>BOOST_ALL_NO_LIB
   <include>../include
;

path-constant parent : .. ;

run /boost/tools/inspect//inspect/<variant>release : $(parent) -text -brief : : <test-info>always_show_run_output : inspect ;
explicit inspect ;

obj undefined_obj : undefined.cpp ;

rule run-test ( name : options * )
{
  local sources = $(name) /boost//unit_test_framework ;

  if $(name:B) in test_integration test_actions_on_function
  {
    sources += undefined_obj ;
  }

  run $(sources) defined_1.cpp defined_2.cpp : : : $(options) : $(name)_ ;
  run $(sources) : : : $(options) <define>MOCK_USE_CONVERSIONS : $(name)_use_conversions ;
  run $(sources) /boost//thread : : : $(options) <define>MOCK_THREAD_SAFE <define>BOOST_THREAD_USES_MOVE <threading>multi : $(name)_thread_safe ;
}

rule run-tests
{
  for name in [ glob test_*.cpp ] { run-test $(name) ; }
  for name in [ glob detail/test_*.cpp ] { run-test $(name) ; }
}

alias mock_tests : [ run-tests ] ;

rule run-failures
{
  for name in [ glob fail_*.cpp ] { compile-fail $(name) ; }
}

alias mock_failures : [ run-failures ] ;

